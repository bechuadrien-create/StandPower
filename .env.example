# GEMINI_API_KEY: Clé API Gemini (serveur uniquement, jamais exposée au frontend).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL du backend pour la configuration CORS (ex: Cloud Run ou domaine du serveur Express).
APP_URL="MY_APP_URL"

# VITE_API_URL: URL absolue du backend pour les builds mobiles APK (laisser vide en développement local web).
VITE_API_URL=""
