# ==============================================================================
# CONFIGURATION D'ENVIRONNEMENT STANDPOWER (SERVEUR EXPRESS & APPLICATION MOBILE)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CÔTÉ SERVEUR EXPRESS (BACKEND UNIQUEMENT)
# ------------------------------------------------------------------------------
# La clé API Gemini reste STRICTEMENT sur le serveur Express (Cloud Run / Node.js).
# Elle ne doit JAMAIS être préfixée par VITE_ ni être incluse dans le bundle mobile.
GEMINI_API_KEY=votre_cle_api_gemini_securisee

# Port du serveur Express (par défaut 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 2. CÔTÉ CLIENT REACT / CAPACITOR MOBILE (BUNDLE STATIQUE)
# ------------------------------------------------------------------------------
# URL absolue du backend Express déployé en production (ex: Cloud Run).
# Utilisée par l'APK Android mobile pour effectuer les requêtes API (/api/generate-guide).
# Laissez vide en développement local web pour utiliser les chemins relatifs (/api).
VITE_API_URL=https://standpower-backend-xyz.a.run.app
